# Токен от @BotFather. Никогда не коммить настоящий .env.
BOT_TOKEN=
# HTTPS-адрес Mini App (появится после деплоя фронта). Пусто — кнопка Mini App не показывается.
WEBAPP_URL=
# Порт локального API.
PORT=8787
# Файл, куда локальное хранилище сохраняет данные.
DATA_FILE=.data/db.json
# Только для разработки в браузере: от чьего имени dev-сервер Vite подписывает запросы к API.
DEV_USER_ID=
DEV_USER_NAME=
