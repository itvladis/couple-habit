{
  "name": "habit-tracker",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @habit/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "dev:web": "npm run dev -w @habit/web",
    "deploy": "tsx --env-file-if-exists=.env scripts/deploy.ts",
    "demo-data": "tsx scripts/demo-data.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
